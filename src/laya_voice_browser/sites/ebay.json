{
  "name": "eBay",
  "hosts": ["ebay.com", "ebay.co.uk", "ebay.ca", "ebay.com.au", "ebay.de", "ebay.fr", "ebay.it"],
  "browsing": {
    "site": "ebay", "home": "https://www.ebay.com/",
    "search_url": "https://www.ebay.com/sch/i.html?_nkw={query}", "query_key": "_nkw",
    "results_selector": "ul.srp-results, .srp-results",
    "result_selector": ".srp-results a[href*='/itm/']",
    "result_card_selector": "li.s-item, li.s-card",
    "result_title_selector": ".s-item__title, .s-card__title",
    "heading_selector": "h1.x-item-title__mainTitle, h1[itemprop='name']",
    "detail_selector": ".x-item-title, #vi_main, #mainContent [data-testid='x-item-title']",
    "navigation": [
      {"label": "Next page of listings", "selector": "a.pagination__next[href], a[aria-label='Go to next search page'][href]"},
      {"label": "Previous page of listings", "selector": "a.pagination__previous[href], a[aria-label='Go to previous search page'][href]"}
    ]
  },
  "actions": [
    {"id": "first_result", "description": "open the first item in the results",
     "say": ["(open|click|show me) the (first|top) (item|listing|result)"],
     "terms": ["look at the first listing", "choose the top item"],
     "do": {"click_css": ["ul.srp-results li.s-item a.s-item__link", "li.s-item a[href]"]}},
    {"id": "next_page", "description": "go to the next page of listings",
     "say": ["(go to |show )?(the )?next page( of listings| of results)?", "more listings"],
     "terms": ["keep looking through listings", "show more items for sale"],
     "do": {"click_css": ["a.pagination__next", "a[aria-label='Go to next search page']"]}},
    {"id": "cart", "description": "open the shopping cart",
     "say": ["(open|show|go to) (my |the )?(shopping )?(cart|basket)"],
     "terms": ["what is in my basket", "show what I am buying"],
     "do": {"open": "https://cart.{host}/"}},
    {"id": "watchlist", "description": "open my watchlist",
     "say": ["(open|show|go to) (my |the )?watch ?list"],
     "terms": ["show the listings I saved", "items I am watching"],
     "do": {"open": "https://www.{host}/mye/myebay/watchlist"}},
    {"id": "add_to_cart", "description": "add this item to the cart", "confirm": true,
     "say": ["add (this|it|the item) to (my |the )?(cart|basket)"],
     "terms": ["put this item in my basket", "save this listing in my cart"],
     "do": {"click": ["add to cart", "add to basket"]}},
    {"id": "watch_item", "description": "add this item to my watchlist", "confirm": true,
     "say": ["(add|save) (this|it|the item) to (my |the )?watch ?list", "watch this item"],
     "terms": ["keep an eye on this listing", "save this item for later"],
     "do": {"click": ["add to watchlist", "watch this item"]}},
    {"id": "buy_now", "description": "buy this item now", "confirm": true,
     "say": ["buy (this|it|the item) now", "purchase (this|it) now"],
     "terms": ["order this immediately", "take me to checkout for this listing"],
     "do": {"click": ["buy it now", "buy now"]}}
  ]
}
