{
  "name": "GitHub",
  "hosts": ["github.com"],
  "actions": [
    {"id": "issues", "description": "open this repository's issues",
     "say": ["(go to|open|show) (the )?issues"],
     "terms": ["show me the bug reports", "people reporting bugs", "what problems are open", "view reported problems"],
     "do": {"open": "https://github.com/{1}/{2}/issues"}},
    {"id": "pulls", "description": "open this repository's pull requests",
     "say": ["(go to|open|show) (the )?(pull requests|prs|pulls)"],
     "terms": ["show proposed changes", "what changes are waiting for review", "open code reviews"],
     "do": {"open": "https://github.com/{1}/{2}/pulls"}},
    {"id": "actions", "description": "open this repository's actions and CI runs",
     "say": ["(go to|open|show) (the )?(actions|ci|workflows|builds)"],
     "terms": ["show the build status", "did continuous integration pass", "view automation runs"],
     "do": {"open": "https://github.com/{1}/{2}/actions"}},
    {"id": "releases", "description": "open this repository's releases",
     "say": ["(go to|open|show) (the )?releases"],
     "terms": ["show published versions", "what is the latest version", "view release downloads"],
     "do": {"open": "https://github.com/{1}/{2}/releases"}},
    {"id": "code", "description": "open this repository's code",
     "say": ["(go to|open|show) (the )?(code|repo|repository|files)"],
     "terms": ["show the source files", "take me to the project files", "browse the source code"],
     "do": {"open": "https://github.com/{1}/{2}"}},
    {"id": "readme", "description": "scroll to the readme",
     "say": ["(show|go to|scroll to|read) (the )?readme"],
     "terms": ["show the project instructions", "how does this project work", "read the documentation on this page"],
     "do": {"scroll_to": ["#readme", "article.markdown-body"]}},
    {"id": "star", "description": "star this repository", "confirm": true,
     "say": ["star (this|the) (repo|repository)"],
     "terms": ["save this repository to my stars", "favorite this project"],
     "do": {"click": ["star this repository", "star"]}}
  ]
}
