{
  "name": "Amazon",
  "hosts": ["amazon.com", "amazon.co.uk", "amazon.in", "amazon.ca", "amazon.com.au", "amazon.de", "amazon.fr", "amazon.it", "amazon.es"],
  "actions": [
    {"id": "first_result", "description": "open the first product result",
     "say": ["(open|click|show me) the (first|top) (product|result|item)"],
     "terms": ["look at the first product", "top product", "choose the top item", "open the first thing for sale"],
     "do": {"click_css": ["[data-component-type=s-search-result] h2 a", "div.s-result-item h2 a"]}},
    {"id": "next_page", "description": "go to the next page of products",
     "say": ["(go to |show )?(the )?next page( of products| of results)?", "more products"],
     "terms": ["keep looking at products", "show more things for sale"],
     "do": {"click_css": ["a.s-pagination-next", ".s-pagination-next:not(.s-pagination-disabled)"]}},
    {"id": "cart", "description": "open the shopping cart",
     "say": ["(open|show|go to) (my |the )?(shopping )?(cart|basket)"],
     "terms": ["what is in my basket", "show what I am buying"],
     "do": {"open": "https://{host}/gp/cart/view.html"}},
    {"id": "orders", "description": "open my orders",
     "say": ["(open|show|go to) (my |the )?(orders|purchases)"],
     "terms": ["things I ordered", "where are my deliveries", "show my purchase history"],
     "do": {"open": "https://{host}/gp/css/order-history"}},
    {"id": "deals", "description": "open today's deals",
     "say": ["(open|show|go to) (today'?s |the )?(deals|offers)"],
     "terms": ["what is on sale", "show me discounted products"],
     "do": {"open": "https://{host}/deals"}},
    {"id": "reviews", "description": "scroll to this product's reviews",
     "say": ["(show|open|go to|scroll to|read) (the )?(reviews|ratings)"],
     "terms": ["what do buyers think", "people who bought this think", "show customer opinions", "is this product any good"],
     "do": {"scroll_to": ["#customerReviews", "#reviews-medley-footer", "[data-hook=reviews-medley-footer]"]}},
    {"id": "add_to_cart", "description": "add this product to the cart", "confirm": true,
     "say": ["add (this|it|the product|the item) to (my |the )?(cart|basket)"],
     "terms": ["put this in my basket", "save this product in my cart"],
     "do": {"click_css": ["#add-to-cart-button", "input[name=submit.add-to-cart]"]}},
    {"id": "buy_now", "description": "buy this product now", "confirm": true,
     "say": ["buy (this|it|the product|the item) now", "purchase (this|it) now"],
     "terms": ["order this immediately", "take me straight to checkout for this"],
     "do": {"click_css": ["#buy-now-button", "input[name=submit.buy-now]"]}}
  ]
}
